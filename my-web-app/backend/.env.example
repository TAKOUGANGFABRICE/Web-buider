# ============================================
# EMAIL CONFIGURATION - Free SMTP Setup
# ============================================

# OPTION 1: Gmail SMTP (RECOMMENDED - Free, 500 emails/day)
# Step 1: Enable 2-Factor Authentication on your Gmail account
# Step 2: Generate an App Password: Google Account → Security → App Passwords
# Step 3: Use the app password below (not your regular Gmail password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=youremail@gmail.com
EMAIL_HOST_PASSWORD=your-16-digit-app-password

# From email MUST match EMAIL_HOST_USER for Gmail
DEFAULT_FROM_EMAIL=youremail@gmail.com

# -----------------------------------------------------

# OPTION 2: Other Free SMTP Providers
# Outlook/Hotmail:
# EMAIL_HOST=smtp-mail.outlook.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=you@outlook.com
# EMAIL_HOST_PASSWORD=your-password
# DEFAULT_FROM_EMAIL=you@outlook.com

# Yahoo Mail:
# EMAIL_HOST=smtp.mail.yahoo.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=you@yahoo.com
# EMAIL_HOST_PASSWORD=your-password
# DEFAULT_FROM_EMAIL=you@yahoo.com

# -----------------------------------------------------

# Note: During development with no credentials, emails print to console
# Production: Consider Amazon SES (62k emails/month free for first year) or
# Mailgun (5k emails/month free for 3 months) for better deliverability

# reCAPTCHA CONFIGURATION - Bot Protection
# Get free keys from: https://www.google.com/recaptcha/admin/create
# Recommended: Use reCAPTCHA v3 (invisible, score-based)

# reCAPTCHA v3 keys (Recommended - invisible, score-based)
RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key
RECAPTCHA_SCORE_THRESHOLD=0.5  # Adjust: 0.3 (lenient) to 0.7 (strict)

# For reCAPTCHA v2 ("I'm not a robot" checkbox):
# Use same keys; score threshold not applicable

# IMPORTANT:
# 1. Add your site domain (localhost for dev, yourdomain.com for prod)
# 2. Use the secret key here, site key goes to frontend
# 3. Keep these keys secret - they grant access to reCAPTCHA service

# ============================================
# FLUTTERWAVE CONFIGURATION - Payment Gateway
# ============================================
# Get API keys from: https://dashboard.flutterwave.com/dashboard/settings/api-keys

FLUTTERWAVE_PUBLIC_KEY=FLW_PUBLIC_KEY_your_key_here
FLUTTERWAVE_SECRET_KEY=FLW_SECRET_KEY_your_key_here
FLUTTERWAVE_ENCRYPTION_KEY=your_encryption_key_here
FLUTTERWAVE_WEBHOOK_SECRET=your_webhook_secret_here

# Frontend URL for payment callbacks
FRONTEND_URL=http://localhost:3001

