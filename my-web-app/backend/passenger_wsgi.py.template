#         headers.append(('X-Powered-By', 'Django/Passenger'))
#         return start_response(status, headers, exc_info)
#     return original_application(environ, custom_start_response)

print(f"✓ Passenger WSGI loaded successfully for {PROJECT_NAME}", file=sys.stderr)
